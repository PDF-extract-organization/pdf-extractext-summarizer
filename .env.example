# Copia este archivo a `.env` y rellena los valores.
# El .env real nunca se commitea.

# --- OpenRouter ---
# Clave del servidor. Opcional: sin ella, solo resumen los usuarios que añadan la suya
# en la página Ajustes de la web. Crea una gratis en https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1
# Modelo de OpenRouter. "openrouter/free" elige uno gratuito cualquiera.
OPENROUTER_MODEL=openrouter/free

# --- Límites de la petición al modelo ---
# Caracteres máximos del texto que se envía; el resto se descarta.
MAX_PROMPT_CHARS=12000
# Tokens máximos de la respuesta. Incluye el razonamiento de los modelos que
# piensan antes de responder: con poco margen, el resumen sale cortado o vacío.
MAX_TOKENS=5000
# Máximo max_tokens que puede pedir un usuario desde Ajustes (protege la cuota de la
# clave del servidor). No limita MAX_TOKENS ni el valor de config.
MAX_TOKENS_LIMIT=8000
# Temperatura del modelo (0 = determinista).
TEMPERATURE=0.3
# Segundos de espera antes de responder 504.
REQUEST_TIMEOUT_SECONDS=60

# --- Configuración centralizada (opcional) ---
# URL del servicio config. Si está, sus claves summarizer/* (model, max_tokens,
# temperature, max_prompt_chars) ganan a las de arriba en cada resumen, sin reiniciar.
# Vacía: solo se usa este archivo. En el stack completo, http://config:8000
CONFIG_URL=
# Segundos de espera a config antes de usar los valores de este archivo.
CONFIG_TIMEOUT_SECONDS=2
